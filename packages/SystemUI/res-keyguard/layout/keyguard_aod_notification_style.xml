<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.clocks.AODLastNotificationsStyle
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/aod_notification_style_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/below_clock_padding_start">

        <TextView android:id="@+id/custom_aod_notification_view"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="top"
            android:maxLines="8" 
            android:singleLine="false"              
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="BaikalOS\nHere will be your notifications..."
            android:visibility="gone">
        </TextView> 
    </RelativeLayout>
</com.android.systemui.clocks.AODLastNotificationsStyle>
